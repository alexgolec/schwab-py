# Schwab developer app credentials for the live API test suite.
#
# Copy this file to schwab-credentials.env in this directory and fill in your
# values. schwab-credentials.env is gitignored and will never be committed.
# Environment variables of the same name override values in that file.
#
# Find your API key and app secret in your app registration on Schwab's
# developer portal. The callback URL must exactly match what's registered for
# your app, and its hostname must be 127.0.0.1.

SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=

# Optional

# Browser in which to open the Schwab login page. Passed to the `webbrowser`
# library; see https://docs.python.org/3/library/webbrowser.html for valid
# values. Set to None to use the system default.
SCHWAB_BROWSER=None

# How long to wait for the login callback before giving up, in seconds.
SCHWAB_CALLBACK_TIMEOUT=300
